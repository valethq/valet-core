{
  "schema": 1,
  "id": "fx-set",
  "name": "Settable",
  "version": "0.1.0",
  "valet": "^0.1.0",
  "main": "./index.ts",
  "provides": ["tools@1"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "enum": ["a", "b"],
        "default": "a"
      },
      "level": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5,
        "default": 3
      },
      "label": {
        "type": "string"
      },
      "reject": {
        "type": "boolean"
      },
      "veto": {
        "type": "boolean"
      }
    }
  }
}
